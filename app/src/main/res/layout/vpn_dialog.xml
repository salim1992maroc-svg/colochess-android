<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="400sp"
        android:layout_gravity="center"
        android:layout_marginStart="8sp"
        android:layout_marginTop="8sp"
        android:layout_marginEnd="8sp"
        android:layout_marginBottom="8sp"
        android:background="@drawable/msg_box"
        android:orientation="vertical">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie"
            android:layout_width="140sp"
            android:layout_height="140sp"
            android:layout_gravity="center"
            android:layout_marginTop="40sp"
            android:layout_marginBottom="2sp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/vpn" />


        <TextView
            android:id="@+id/title_tv_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10sp"
            android:gravity="center"
            android:text="@string/title_vpn"
            android:textColor="@color/purple_500"
            android:textSize="18dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/desc_tv_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="4sp"
            android:gravity="center"
            android:text="@string/desc_vpn"
            android:textColor="@color/purple_500"
            android:textSize="14dp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20sp">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/vpn_btn"
                android:layout_width="180sp"
                android:layout_height="50sp"
                android:layout_gravity="center"
                android:background="@drawable/btn_bg"
                android:text="OK"
                android:textAllCaps="false"
                android:textColor="@color/purple_500"
                android:textSize="16sp"
                tools:ignore="TouchTargetSizeCheck" />


        </LinearLayout>


    </LinearLayout>

    <ImageView
        android:id="@+id/exite1"
        android:layout_width="50sp"
        android:layout_height="50sp"
        app:srcCompat="@drawable/but_exit" />
</RelativeLayout>